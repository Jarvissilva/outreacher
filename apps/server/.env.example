HOST=127.0.0.1
PORT=3001
# Defaults to ~/.local/share/outreacher (resolved from the current user home).
# Optional directory override. Relative paths resolve from the working directory.
# DATA_DIR=/absolute/path/to/outreacher
# Optional explicit database file. Overrides DATA_DIR when set.
# DATABASE_PATH=/absolute/path/to/outreacher.sqlite

# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable and back it up separately from the database.
EMAIL_ENCRYPTION_KEY=
# Public origin (or reverse-proxy prefix) that routes /unsubscribe/* to Express.
PUBLIC_UNSUBSCRIBE_BASE_URL=

# Optional exact, comma-separated additions for a private MCP reverse proxy.
# Defaults allow localhost, 127.0.0.1 and [::1] on PORT. These are not authentication.
# MCP_ALLOWED_HOSTS=outreach.example.com
# MCP_ALLOWED_ORIGINS=https://outreach.example.com
