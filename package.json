{
  "name": "outreacher",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "pnpm --filter @outreacher/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @outreacher/server start",
    "typecheck": "pnpm --filter @outreacher/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @outreacher/shared build && pnpm --filter @outreacher/server test && pnpm --filter @outreacher/client test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
